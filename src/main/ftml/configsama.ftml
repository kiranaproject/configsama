          }

          Container {
            styleClass: "card-divider";
            anchors.top: rowDisplayLanguage.bottom;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 1;
            drawFrame: false;
          }

          // Row 2: Regional Formats
          Container {
            id: rowRegionalFormats;
            anchors.top: rowDisplayLanguage.bottom;
            anchors.topMargin: 1;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 54;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.top: parent.top;
              anchors.topMargin: 8;
              height: 18;
              text: "Regional Formats";
              font: "Sans 12";
              selectable: false;
            }

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.top: parent.top;
              anchors.topMargin: 29;
              height: 16;
              text: "Standards used for numbers, dates, and currency";
              font: "Sans 9";
              opacity: 0.65;
              selectable: false;
            }

            ComboBox {
              id: cmbRegionalFormats;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              width: 220;
              height: 30;
              items: "United States (en_US.UTF-8), Indonesia (id_ID.UTF-8), Japan (ja_JP.UTF-8)";
            }
          }
        }

        // Card 2: Regional Formats Preview
        Container {
          id: cardFormatsPreview;
          styleClass: "settings-card";
          anchors.top: cardLanguageSettings.bottom;
          anchors.topMargin: 14;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 162;
          drawFrame: false;

          Text {
            anchors.top: parent.top;
            anchors.topMargin: 12;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            text: "Preview of Regional Formats";
            font: "Sans:bold 12";
            selectable: false;
          }

          // Row 1: Dates
          Container {
            id: rowPreviewDates;
            anchors.top: parent.top;
            anchors.topMargin: 36;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 38;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Dates";
              font: "Sans 11";
              opacity: 0.7;
              selectable: false;
            }

            Text {
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Sunday, November 8, 2026 (2026-11-08)";
              font: "Sans 11";
              selectable: false;
            }
          }

          Container {
            styleClass: "card-divider";
            anchors.top: rowPreviewDates.bottom;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 1;
            drawFrame: false;
          }

          // Row 2: Times
          Container {
            id: rowPreviewTimes;
            anchors.top: rowPreviewDates.bottom;
            anchors.topMargin: 1;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 38;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Times";
              font: "Sans 11";
              opacity: 0.7;
              selectable: false;
            }

            Text {
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "13:30:00 (1:30:00 PM)";
              font: "Sans 11";
              selectable: false;
            }
          }

          Container {
            styleClass: "card-divider";
            anchors.top: rowPreviewTimes.bottom;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 1;
            drawFrame: false;
          }

          // Row 3: Numbers & Currency
          Container {
            id: rowPreviewNumbers;
            anchors.top: rowPreviewTimes.bottom;
            anchors.topMargin: 1;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 38;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Numbers & Currency";
              font: "Sans 11";
              opacity: 0.7;
              selectable: false;
            }

            Text {
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "1,234,567.89  •  $1,234.56";
              font: "Sans 11";
              selectable: false;
            }
          }
        }
      }

      // ── 9. Battery Page ──
      Container {
        id: pageBattery;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        // Card 1: Charge Status (Blue gradient banner)
        Container {
          id: cardBatteryBanner;
          styleClass: "battery-banner-card";
          anchors.top: parent.top;
          anchors.topMargin: 4;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 140;
          drawFrame: false;

          Text {
            id: lblBatteryPercent;
            anchors.top: parent.top;
            anchors.topMargin: 24;
            anchors.left: parent.left;
            anchors.leftMargin: 24;
            text: "68%";
            font: "Sans:bold 36";
            style: "color: #ffffff;";
            selectable: false;
          }

          Text {
            id: lblBatteryRemaining;
            anchors.top: lblBatteryPercent.bottom;
            anchors.topMargin: 8;
            anchors.left: parent.left;
            anchors.leftMargin: 24;
            text: "1 hr 25 min remaining";
            font: "Sans 12";
            style: "color: #e0f2fe;";
            selectable: false;
          }

          Image {
            id: imgBatteryBolt;
            anchors.right: parent.right;
            anchors.rightMargin: 24;
            anchors.verticalCenter: parent.verticalCenter;
            width: 56;
            height: 56;
            icon: "battery-bolt";
          }
        }

        // Card 2: Battery Health / Capacity
        Container {
          id: cardBatteryHealth;
          styleClass: "settings-card";
          anchors.top: cardBatteryBanner.bottom;
          anchors.topMargin: 14;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 52;
          drawFrame: false;

          Text {
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.verticalCenter: parent.verticalCenter;
            text: "Maximum Capacity";
            font: "Sans 12";
            selectable: false;
          }

          Text {
            id: lblMaxCapacity;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            anchors.verticalCenter: parent.verticalCenter;
            text: "100%";
            font: "Sans:bold 12";
            selectable: false;
          }
        }

        // Backwards-compatible hidden controls
        ComboBox { id: cmbPowerMode; visible: false; items: "Performance, Balanced, Power Saver"; }
        ComboBox { id: cmbScreenBlank; visible: false; items: "Never"; }
        Switch { id: swAutoSuspend; visible: false; }
        Entry { id: txtPowerStatus; visible: false; text: "100%"; }
      }

      // ── 10. About Page ──
      Container {
        id: pageAbout;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        Container {
          id: cardAbout;
          styleClass: "settings-card";
          anchors.top: parent.top;
          anchors.topMargin: 8;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 380;
          drawFrame: false;

          FormGrid {
            anchors.fill: parent;
            anchors.leftMargin: 20;
            anchors.topMargin: 16;
            anchors.rightMargin: 20;
            anchors.bottomMargin: 16;

            FormSection { title: "System Details"; }
            FormRow {
              label: "Operating System";
              Entry {
                id: txtAboutOs;
                width: 300;
                height: 30;
                text: "Samarinda OS 1.0 (Kutai Edition)";
                readOnly: true;
              }
            }
            FormRow {
              label: "Desktop Shell";
              Entry {
                id: txtAboutShell;
                width: 300;
                height: 30;
                text: "shellsama (Native X11 Shell)";
                readOnly: true;
              }
            }
            FormRow {
              label: "Window Manager";
              Entry {
                id: txtAboutWm;
                width: 300;
                height: 30;
                text: "wmsama (Compositing Window Manager)";
                readOnly: true;
              }
            }
            FormRow {
              label: "Toolkit";
              Entry {
                id: txtAboutToolkit;
                width: 300;
                height: 30;
                text: "Floria Toolkit 0.0.1 (libft / ftpas)";
                readOnly: true;
              }
            }

            FormSection { title: "Hardware Information"; }
            FormRow {
              label: "Linux Kernel";
              Entry {
                id: txtAboutKernel;
                width: 300;
                height: 30;
                text: "Linux";
                readOnly: true;
              }
            }
            FormRow {
              label: "Processor";
              Entry {
                id: txtAboutCpu;
                width: 300;
                height: 30;
                text: "x86_64 Processor";
                readOnly: true;
              }
            }
            FormRow {
              label: "System Memory";
              Entry {
                id: txtAboutMem;
                width: 300;
                height: 30;
                text: "8.0 GiB";
                readOnly: true;
              }
            }
          }
        }
      }

      // ── Backward-Compatibility Pages (Hidden by default) ──
      Container {
        id: pageSound;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        FormGrid {
          anchors.fill: parent;
          anchors.leftMargin: 24;
          anchors.topMargin: 16;
          anchors.rightMargin: 24;
          anchors.bottomMargin: 16;

          FormSection { title: "Sound Output"; }
          FormRow {
            label: "Output Device";
            ComboBox {
              id: cmbOutputDevice;
              items: "Default Audio Sink, Analog Stereo, HDMI / DisplayPort Audio";
            }
          }
          FormRow {
            label: "Output Volume";
            Row {
              Slider {
                id: slVolume;
                width: 220;
                height: 24;
              }
            }
          }
          FormRow {
            label: "Mute Output";
            Row {
              Switch { id: swMute; width: 50; height: 28; }
            }
          }
          FormRow {
            label: "System Alert Sounds";
            Row {
              Switch { id: swSoundEffects; width: 50; height: 28; }
            }
          }
        }
      }

      Container {
        id: pagePower;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;
      }

      Container {
        id: pageMouse;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        FormGrid {
          anchors.fill: parent;
          anchors.leftMargin: 24;
          anchors.topMargin: 16;
          anchors.rightMargin: 24;
          anchors.bottomMargin: 16;

          FormSection { title: "Mouse"; }
          FormRow {
            label: "Primary Button";
            ComboBox { id: cmbPrimaryBtn; items: "Left, Right"; }
          }
          FormRow {
            label: "Pointer Speed";
            Row { Slider { id: slPointerSpeed; width: 220; height: 24; } }
          }
          FormRow {
            label: "Natural Scrolling";
            Row { Switch { id: swNaturalScroll; width: 50; height: 28; } }
          }
          FormRow {
            label: "Tap to Click";
            Row { Switch { id: swTapToClick; width: 50; height: 28; } }
          }
        }
      }

      Container {
        id: pageKeyboard;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        FormGrid {
          anchors.fill: parent;
          anchors.leftMargin: 24;
          anchors.topMargin: 16;
          anchors.rightMargin: 24;
          anchors.bottomMargin: 16;

          FormSection { title: "Input & Layout"; }
          FormRow {
            label: "Keyboard Layout";
            ComboBox { id: cmbKeyboardLayout; items: "English (US), Indonesian, Japanese, German, French"; }
          }
          FormRow {
            label: "Key Repeat Delay";
            Row { Slider { id: slKeyDelay; width: 220; height: 24; } }
          }
          FormRow {
            label: "Key Repeat Speed";
            Row { Slider { id: slKeyRate; width: 220; height: 24; } }
          }
          FormRow {
            label: "Super Key Opens Launcher";
            Row { Switch { id: swSuperLauncher; width: 50; height: 28; } }
          }
        }
      }

      Container {
        id: pageApps;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        FormGrid {
          anchors.fill: parent;
          anchors.leftMargin: 24;
          anchors.topMargin: 16;
          anchors.rightMargin: 24;
          anchors.bottomMargin: 16;

          FormSection { title: "Default Applications"; }
          FormRow {
            label: "Web Browser";
            ComboBox { id: cmbBrowser; items: "Default Web Browser, Mozilla Firefox, Chromium"; }
          }
          FormRow {
            label: "File Manager";
            ComboBox { id: cmbFileManager; items: "filesama (Samarinda Files), Standard File Manager"; }
          }
          FormRow {
            label: "Terminal Emulator";
            ComboBox { id: cmbTerminal; items: "samarinda-terminal, XTerm"; }
          }
          FormRow {
            label: "Text Editor";
            ComboBox { id: cmbEditor; items: "Default Text Editor, Nano, Gedit"; }
          }
        }
      }
    }
  }
}
