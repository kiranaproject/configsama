// @form TConfigSamaWindow
//
// configsama — desktop settings application modelled in FTML with ECA.
// Left sidebar with category navigation; right content area with grouped settings cards.
//
Window {
  id: mainWindow;
  title: "Settings";
  extendedClientArea: true;
  width: 960;
  height: 640;

  // ── Left Sidebar Pane ──
  Container {
    id: sidebar;
    anchors.top: parent.top;
    anchors.left: parent.left;
    anchors.bottom: parent.bottom;
    width: 240;
    padding: 0;
    drawFrame: false;

    Text {
      id: appTitle;
      anchors.top: parent.top;
      anchors.topMargin: 18;
      anchors.left: parent.left;
      anchors.leftMargin: 20;
      text: "Settings";
      font: "Sans:bold 14";
      selectable: false;
    }

    Container {
      id: searchContainer;
      anchors.top: appTitle.bottom;
      anchors.topMargin: 12;
      anchors.left: parent.left;
      anchors.right: parent.right;
      height: 36;
      padding: 0;
      drawFrame: false;

      Entry {
        id: searchEntry;
        anchors.left: parent.left;
        anchors.right: parent.right;
        anchors.leftMargin: 16;
        anchors.rightMargin: 16;
        anchors.verticalCenter: parent.verticalCenter;
        height: 28;
        placeholder: "Search settings...";
      }
    }

    TreeView {
      id: categoryTree;
      anchors.top: searchContainer.bottom;
      anchors.topMargin: 8;
      anchors.left: parent.left;
      anchors.leftMargin: 10;
      anchors.right: parent.right;
      anchors.rightMargin: 10;
      anchors.bottom: parent.bottom;
      itemHeight: 38;
      indentWidth: 10;
      drawFrame: false;

      TreeNode {
        text: "Network and connection";
        isHeader: true;
        expanded: true;
        TreeNode { text: "WLAN"; icon: "wlan"; iconSelected: "wlan-white"; }
        TreeNode { text: "Wired"; icon: "wired"; iconSelected: "wired-white"; }
      }
      TreeNode {
        text: "Display and appearance";
        isHeader: true;
        expanded: true;
        TreeNode { text: "Display"; icon: "display"; iconSelected: "display-white"; }
        TreeNode { text: "Appearance"; icon: "appearance"; iconSelected: "appearance-white"; }
        TreeNode { text: "Background"; icon: "background"; iconSelected: "background-white"; }
        TreeNode { text: "Dock"; icon: "dock"; iconSelected: "dock-white"; }
      }
      TreeNode {
        text: "System";
        isHeader: true;
        expanded: true;
        TreeNode { text: "User"; icon: "user"; iconSelected: "user-white"; }
        TreeNode { text: "Language"; icon: "language"; iconSelected: "language-white"; }
        TreeNode { text: "Battery"; icon: "battery"; iconSelected: "battery-white"; }
        TreeNode { text: "About"; icon: "about"; iconSelected: "about-white"; }
      }
    }
  }

  // ── Right Content Area ──
  Container {
    id: contentArea;
    anchors.top: parent.top;
    anchors.left: sidebar.right;
    anchors.right: parent.right;
    anchors.bottom: parent.bottom;
    padding: 0;
    drawFrame: false;

    Container {
      id: contentHeader;
      anchors.top: parent.top;
      anchors.left: parent.left;
      anchors.right: parent.right;
      height: 58;
      drawFrame: false;

      Text {
        id: sectionTitle;
        anchors.left: parent.left;
        anchors.leftMargin: 36;
        anchors.verticalCenter: parent.verticalCenter;
        text: "WLAN";
        font: "Sans:bold 16";
        selectable: false;
      }
    }

    Container {
      id: pageContainer;
      anchors.top: contentHeader.bottom;
      anchors.left: parent.left;
      anchors.right: parent.right;
      anchors.bottom: parent.bottom;
      drawFrame: false;

      // ── 1. WLAN Page ──
      Container {
        id: pageWlan;
        anchors.fill: parent;
        visible: true;
        drawFrame: false;

        Container {
          id: cardWlan;
          styleClass: "settings-card";
          anchors.top: parent.top;
          anchors.topMargin: 4;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 252;
          drawFrame: false;

          // Row 0: WLAN toggle
          Container {
            id: rowWlanStatus;
            anchors.top: parent.top;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 52;
            padding: 0;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "WLAN";
              font: "Sans:bold 12";
              selectable: false;
            }

            Switch {
              id: swWlan;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              width: 48;
              height: 26;
              checked: true;
            }
          }

          // Row 1: "Purr" network (connected)
          Container {
            id: rowWifiPurr;
            anchors.top: rowWlanStatus.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 50;
            padding: 0;
            drawFrame: false;

            Image {
              id: imgWifiPurr;
              icon: "wlan";
              width: 18;
              height: 18;
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 48;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Purr";
              font: "Sans 12";
              selectable: false;
            }

            Image {
              id: imgLockPurr;
              icon: "lock";
              width: 14;
              height: 14;
              anchors.right: imgCheckPurr.left;
              anchors.rightMargin: 14;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Image {
              id: imgCheckPurr;
              icon: "dialog-success";
              width: 16;
              height: 16;
              anchors.right: btnPurrInfo.left;
              anchors.rightMargin: 12;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Button {
              id: btnPurrInfo;
              icon: "info-accent";
              width: 24;
              height: 24;
              flat: true;
              drawFrame: false;
              style: "background-color: transparent; border: none; box-shadow: none;";
              anchors.right: parent.right;
              anchors.rightMargin: 16;
              anchors.verticalCenter: parent.verticalCenter;
            }
          }

          // Row 2: "Meow" network
          Container {
            id: rowWifiMeow;
            anchors.top: rowWifiPurr.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 50;
            padding: 0;
            drawFrame: false;

            Image {
              id: imgWifiMeow;
              icon: "wlan";
              width: 18;
              height: 18;
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 48;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Meow";
              font: "Sans 12";
              selectable: false;
            }

            Image {
              id: imgLockMeow;
              icon: "lock";
              width: 14;
              height: 14;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }
          }

          // Row 3: "Virgin Media" network
          Container {
            id: rowWifiVirgin;
            anchors.top: rowWifiMeow.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 50;
            padding: 0;
            drawFrame: false;

            Image {
              id: imgWifiVirgin;
              icon: "wlan";
              width: 18;
              height: 18;
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 48;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Virgin Media";
              font: "Sans 12";
              selectable: false;
            }

            Image {
              id: imgLockVirgin;
              icon: "lock";
              width: 14;
              height: 14;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }
          }

          // Row 4: "VM6974871" network
          Container {
            id: rowWifiVM;
            anchors.top: rowWifiVirgin.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 50;
            padding: 0;
            drawFrame: false;

            Image {
              id: imgWifiVM;
              icon: "wlan";
              width: 18;
              height: 18;
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 48;
              anchors.verticalCenter: parent.verticalCenter;
              text: "VM6974871";
              font: "Sans 12";
              selectable: false;
            }

            Image {
              id: imgLockVM;
              icon: "lock";
              width: 14;
              height: 14;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }
          }
        }
      }

      // ── 2. Wired Page ──
      Container {
        id: pageWired;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        Container {
          id: cardWired;
          styleClass: "settings-card";
          anchors.top: parent.top;
          anchors.topMargin: 8;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 156;
          drawFrame: false;

          Container {
            id: rowWiredStatus;
            anchors.top: parent.top;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 52;
            padding: 0;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Wired Connection";
              font: "Sans:bold 12";
              selectable: false;
            }

            Switch {
              id: swWired;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              width: 48;
              height: 26;
              checked: true;
            }
          }

          Container {
            id: rowWiredSpeed;
            anchors.top: rowWiredStatus.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 52;
            padding: 0;
            drawFrame: false;

            Image {
              id: imgWired;
              icon: "wired";
              width: 18;
              height: 18;
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
            }

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 48;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Connected — 1000 Mb/s (Full Duplex)";
              font: "Sans 12";
              selectable: false;
            }
          }

          Container {
            id: rowWiredHw;
            anchors.top: rowWiredSpeed.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 52;
            padding: 0;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "IPv4: 192.168.1.100  •  Gateway: 192.168.1.1";
              font: "Sans 11";
              selectable: false;
            }
          }
        }
      }

      // ── 3. Displays Page ──
      Container {
        id: pageDisplays;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        // Card 1: Brightness
        Container {
          id: cardBrightness;
          styleClass: "settings-card";
          anchors.top: parent.top;
          anchors.topMargin: 4;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 80;
          drawFrame: false;

          Text {
            anchors.top: parent.top;
            anchors.topMargin: 12;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            text: "Brightness";
            font: "Sans:bold 12";
            selectable: false;
          }

          Image {
            id: imgBrightnessLow;
            icon: "brightness-low";
            width: 16;
            height: 16;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.bottom: parent.bottom;
            anchors.bottomMargin: 16;
          }

          Slider {
            id: sldBrightness;
            anchors.left: imgBrightnessLow.right;
            anchors.leftMargin: 12;
            anchors.right: imgBrightnessHigh.left;
            anchors.rightMargin: 12;
            anchors.verticalCenter: imgBrightnessLow.verticalCenter;
            height: 24;
            min: 0;
            max: 100;
            value: 80;
          }

          Image {
            id: imgBrightnessHigh;
            icon: "brightness-high";
            width: 16;
            height: 16;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            anchors.verticalCenter: imgBrightnessLow.verticalCenter;
          }
        }

        // Card 2: Screen Configuration
        Container {
          id: cardScreen;
          styleClass: "settings-card";
          anchors.top: cardBrightness.bottom;
          anchors.topMargin: 14;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 196;
          drawFrame: false;

          Text {
            anchors.top: parent.top;
            anchors.topMargin: 12;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            text: "Screen";
            font: "Sans:bold 12";
            selectable: false;
          }

          // Row 1: Resolution
          Container {
            id: rowResolution;
            anchors.top: parent.top;
            anchors.topMargin: 38;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 48;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Resolution";
              font: "Sans 12";
              selectable: false;
            }

            ComboBox {
              id: cmbResolution;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              width: 220;
              height: 30;
              items: "1920 × 1080 (Default), 1680 × 1050, 1440 × 900, 1280 × 800";
            }
          }

          Container {
            styleClass: "card-divider";
            anchors.top: rowResolution.bottom;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 1;
            drawFrame: false;
          }

          // Row 2: Refresh Rate
          Container {
            id: rowRefreshRate;
            anchors.top: rowResolution.bottom;
            anchors.topMargin: 1;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 48;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Refresh rate";
              font: "Sans 12";
              selectable: false;
            }

            ComboBox {
              id: cmbRefreshRate;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              width: 140;
              height: 30;
              items: "60.00 Hz, 75.00 Hz, 120.00 Hz, 144.00 Hz";
            }
          }

          Container {
            styleClass: "card-divider";
            anchors.top: rowRefreshRate.bottom;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 1;
            drawFrame: false;
          }

          // Row 3: Rotation
          Container {
            id: rowRotation;
            anchors.top: rowRefreshRate.bottom;
            anchors.topMargin: 1;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 48;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Rotation";
              font: "Sans 12";
              selectable: false;
            }

            Row {
              id: rowRotationBtns;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              height: 30;
              spacing: 6;

              Button {
                id: btnRotate0;
                width: 38;
                height: 28;
                icon: "rotate-0";
                styleClass: "segmented-btn";
              }
              Button {
                id: btnRotate90;
                width: 38;
                height: 28;
                icon: "rotate-90";
                styleClass: "segmented-btn";
              }
              Button {
                id: btnRotate180;
                width: 38;
                height: 28;
                icon: "rotate-180";
                styleClass: "segmented-btn";
              }
              Button {
                id: btnRotate270;
                width: 38;
                height: 28;
                icon: "rotate-270";
                styleClass: "segmented-btn";
              }
            }
          }
        }

        // Card 3: Scale
        Container {
          id: cardScale;
          styleClass: "settings-card";
          anchors.top: cardScreen.bottom;
          anchors.topMargin: 14;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 96;
          drawFrame: false;

          Text {
            anchors.top: parent.top;
            anchors.topMargin: 12;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            text: "Scale";
            font: "Sans:bold 12";
            selectable: false;
          }

          SegmentedControl {
            id: segScale;
            anchors.top: parent.top;
            anchors.topMargin: 42;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 36;
            items: "100%, 125%, 150%, 175%, 200%";
            selectedIndex: 0;
          }
        }
      }

      // ── 4. Appearance Page ──
      Container {
        id: pageAppearance;
        anchors.fill: parent;
        visible: false;
        drawFrame: false;

        // Card 1: Theme
        Container {
          id: cardTheme;
          styleClass: "settings-card";
          anchors.top: parent.top;
          anchors.topMargin: 4;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 180;
          drawFrame: false;

          Text {
            anchors.top: parent.top;
            anchors.topMargin: 12;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            text: "Theme";
            font: "Sans:bold 12";
            selectable: false;
          }

          // Row of theme preview cards
          Row {
            id: rowThemePreviews;
            anchors.top: parent.top;
            anchors.topMargin: 38;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            height: 78;
            spacing: 20;

            Container {
              id: cardThemeLight;
              width: 104;
              height: 74;
              styleClass: "theme-choice";
              drawFrame: false;

              Button {
                id: btnThemeLight;
                anchors.top: parent.top;
                anchors.horizontalCenter: parent.horizontalCenter;
                width: 96;
                height: 48;
                icon: "theme-light";
                styleClass: "theme-preview-btn";
              }

              Text {
                anchors.bottom: parent.bottom;
                anchors.horizontalCenter: parent.horizontalCenter;
                text: "Light";
                font: "Sans 11";
                selectable: false;
              }
            }

            Container {
              id: cardThemeDark;
              width: 104;
              height: 74;
              styleClass: "theme-choice";
              drawFrame: false;

              Button {
                id: btnThemeDark;
                anchors.top: parent.top;
                anchors.horizontalCenter: parent.horizontalCenter;
                width: 96;
                height: 48;
                icon: "theme-dark";
                styleClass: "theme-preview-btn";
              }

              Text {
                anchors.bottom: parent.bottom;
                anchors.horizontalCenter: parent.horizontalCenter;
                text: "Dark";
                font: "Sans 11";
                selectable: false;
              }
            }
          }

          Container {
            styleClass: "card-divider";
            anchors.top: rowThemePreviews.bottom;
            anchors.topMargin: 10;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            anchors.right: parent.right;
            anchors.rightMargin: 18;
            height: 1;
            drawFrame: false;
          }

          // Dim in dark mode row
          Container {
            id: rowDimDark;
            anchors.bottom: parent.bottom;
            anchors.left: parent.left;
            anchors.right: parent.right;
            height: 46;
            drawFrame: false;

            Text {
              anchors.left: parent.left;
              anchors.leftMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              text: "Dim window titlebar in dark mode";
              font: "Sans 12";
              selectable: false;
            }

            Switch {
              id: swDarkMode;
              anchors.right: parent.right;
              anchors.rightMargin: 18;
              anchors.verticalCenter: parent.verticalCenter;
              width: 48;
              height: 26;
              checked: false;
            }
          }
        }

        // Card 2: Accent color
        Container {
          id: cardAccent;
          styleClass: "settings-card";
          anchors.top: cardTheme.bottom;
          anchors.topMargin: 14;
          anchors.left: parent.left;
          anchors.leftMargin: 36;
          anchors.right: parent.right;
          anchors.rightMargin: 36;
          height: 94;
          drawFrame: false;

          Text {
            anchors.top: parent.top;
            anchors.topMargin: 12;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            text: "Accent color";
            font: "Sans:bold 12";
            selectable: false;
          }

          Row {
            id: rowAccentSwatches;
            anchors.top: parent.top;
            anchors.topMargin: 42;
            anchors.left: parent.left;
            anchors.leftMargin: 18;
            height: 36;
            spacing: 12;

            Button {
              id: btnAccentMulti;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-multi";
            }
            Button {
              id: btnAccentBlue;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-blue";
            }
            Button {
              id: btnAccentPurple;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-purple";
            }
            Button {
              id: btnAccentPink;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-pink";
            }
            Button {
              id: btnAccentRed;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-red";
            }
            Button {
              id: btnAccentOrange;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-orange";
            }
            Button {
              id: btnAccentYellow;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-yellow";
            }
            Button {
              id: btnAccentGreen;
              width: 28;
              height: 28;
              styleClass: "swatch-btn swatch-green";
            }
          }

          // Backwards-compatible hidden ComboBox
          ComboBox {
            id: cmbAccent;
            visible: false;
            items: "Blue, Purple, Emerald, Amber, Crimson, Slate";
          }
        }

        // Card 3: Font
        Container {
          id: cardFont;
          styleClass: "settings-card";
